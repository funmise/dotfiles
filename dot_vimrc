" =============================
" Leader Key Configuration
" =============================

" Use Space as the leader key
let mapleader = " "

" ============================
" Vertical Ruler & Wrap Text Config
" ============================
" --- Default color column for most files ---
set colorcolumn=80

" --- Style for the color column (gray background) ---
highlight ColorColumn ctermbg=darkgray guibg=#2c2c2c

" --- Ensure Vim detects file types ---
filetype plugin indent on

" --- Dynamically set color columns for specific file types ---
augroup dynamic_colorcolumn
  autocmd!
  " For Git commit messages: rulers at 50(subject) and 72(body), wrap text at 72
  autocmd FileType gitcommit setlocal colorcolumn=50,72,80 textwidth=72 formatoptions+=t
augroup END

" ===============================
" Line & Syntax Configuration
" ===============================

" Show absolute line numbers
set number

" Show relative numbers for easier navigation
set relativenumber

" (Optional) keep the current line absolute while others are relative
" This already happens when both 'number' and 'relativenumber' are on

" Enable syntax highlighting
syntax on

" Show as much of the last visible line as possible instead of @ placeholders
set display+=lastline

" Tab and indentation settings
" tabstop=4     -> display a tab as 4 columns wide
" shiftwidth=4  -> indentation commands like >> use 4 spaces
" expandtab     -> pressing Tab inserts spaces instead of a literal tab
set tabstop=4
set shiftwidth=4
set expandtab

" =============================
" Window & Split Configuration
" =============================

" Always show the status line
set laststatus=2

" Open new vertical splits to the right
set splitright

" Open new horizontal splits below
set splitbelow

" =============================
" Mouse & Key Configuration
" =============================

" Let Vim handle mouse/trackpad input in all modes
" Needed for proper mouse scrolling, especially when running inside tmux
set mouse=a

" Use the macOS/Linux system clipboard for normal yank/delete/put operations
if has("mac")
    set clipboard=unnamed
else
    set clipboard=unnamedplus
endif

" Disable Q in Normal mode because it enters Ex mode
nnoremap Q <Nop>

" Fuzzy-find file with Ctrl + p
nnoremap <C-p> :Files<CR>

" Toggle NERDTree with Space + n
nnoremap <leader>n :NERDTreeToggle<CR>

" ============================
" Search Configuration
" ============================

" Keep all search matches highlighted
set hlsearch

" Highlight the current search match in orange
highlight CurSearch cterm=bold ctermfg=black ctermbg=208
      \ gui=bold guifg=black guibg=#ff8700

" Temporarily clear search highlighting with Space + h
" The search itself is still remembered; n/N or a new search brings highlighting back
nnoremap <leader>h :nohlsearch<CR>

" This setting makes search case-insensitive when all characters in the string
" being searched are lowercase. However, the search becomes case-sensitive if
" it contains any capital letters. This makes searching more convenient.
set ignorecase
set smartcase

" Enable searching as you type, rather than waiting till you press enter.
set incsearch

" =============================
" Appearance Configuration
" =============================

" Use true colors in the terminal
set termguicolors

" Use a dark background
set background=dark

" Highlight the current line and line number
set cursorline
set cursorlineopt=both

" =============================
" Plugin Configuration
" =============================
call plug#begin()

Plug 'itchyny/lightline.vim'
Plug 'junegunn/fzf'
Plug 'junegunn/fzf.vim'
Plug 'preservim/nerdtree'
Plug 'joshdick/onedark.vim'
Plug 'tomasr/molokai'
Plug 'easymotion/vim-easymotion'

call plug#end()

" Lightline appearance
let g:lightline = {
      \ 'colorscheme': 'one',
      \ }

" Use Molokai as the main Vim colorscheme
colorscheme molokai
