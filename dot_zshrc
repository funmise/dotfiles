# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# ---- PATH handling (dedupe + stable order) ----
# In zsh, PATH is mirrored by the array "path".
# -U makes entries unique automatically (no duplicates even if I source repeatedly).
typeset -U path PATH

# Add Flutter SDK first
path=(/Applications/flutter/bin $path)

# Dart/Flutter pub global executables
path=($HOME/.pub-cache/bin $path)

# ---- Terminal quality-of-life ----
# Disable XON/XOFF flow control so Ctrl-S works (forward search) instead of freezing the terminal
[[ -t 0 ]] && stty -ixon

# ---- Node (nvm) ----
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # loads nvm_bash completion

# ---- Java ----
export JAVA_HOME=$(/usr/libexec/java_home -v 17)
path=($JAVA_HOME/bin $path)

# ---- zsh help that feels like bash help ----
# Use Zsh's internal run-help
alias run-help >/dev/null 2>&1 && unalias run-help
autoload -Uz run-help

# Set the correct help directory for system zsh 5.9
HELPDIR=/usr/share/zsh/5.9/help

# Make "help" behave like run-help
alias help=run-help

# Created by `pipx` on 2025-12-29 09:58:34
path=($path $HOME/.local/bin)

# ---- History behavior ----
setopt HIST_IGNORE_SPACE

# ---- Extra Zsh completion definitions ----                                    
fpath=("$(brew --prefix)/share/zsh-completions" $fpath)                         
                                                                                
# Initialize Zsh completion                                                     
autoload -Uz compinit                                                           
compinit 

# Set up fzf key bindings and fuzzy completion
source <(fzf --zsh)

# ---- zsh autosuggestions ----
# Shows grey inline suggestions based mainly on shell history.
if [[ -f "$(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]]; then
  source "$(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi

# ---- History substring search ----
# Type part of an old command, then use Up/Down to cycle through matching history.
source "$(brew --prefix)/share/zsh-history-substring-search/zsh-history-substring-search.zsh"

bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down

# ---- zoxide (smart cd) ----
if command -v zoxide >/dev/null; then
  eval "$(zoxide init zsh)"
fi

# ---- bash like bindings ---- 
bindkey '^U' backward-kill-line

