# Set up shell wrapper that provides the ability to change the current working 
# directory when exiting Yazi.
function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	command yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd"
	command rm -f -- "$tmp"
}

# shorten eza
alias ez='eza'

# Make ls always show color
alias ls='ls --color=auto'

# --- Setup powerlevel10k --- #
source /opt/homebrew/share/powerlevel10k/powerlevel10k.zsh-theme

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# Better grep highlighting: black text on light-yellow background
export GREP_COLOR='30;103'
alias grep='grep --color=auto'

# less search highlighting: black text on light-yellow background
export LESS_TERMCAP_so=$'\e[30;103m'
export LESS_TERMCAP_se=$'\e[0m'

# shorten common git commands
alias gts='git status'
alias gtc='git commit'
alias gtb='git branch'
alias gtk='git checkout'


# ---- zsh syntax highlighting ----
# Colors commands/arguments as you type. Keep this near the end of ~/.zshrc.
if [[ -f "$(brew --prefix)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]]; then
  source "$(brew --prefix)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi
